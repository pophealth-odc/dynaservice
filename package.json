{
  "name": "cloud-screenshot-service",
  "version": "1.0.0",
  "description": "Cloud-based screenshot automation service: Express + Playwright (headless Chromium) for Render Free Web Services.",
  "private": true,
  "license": "UNLICENSED",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --import ./tests/helpers/setup.js --test --test-concurrency=1 \"tests/unit/**/*.test.js\"",
    "test:integration": "node --import ./tests/helpers/setup.js --test --test-concurrency=1 \"tests/integration/**/*.test.js\"",
    "test:browser": "node --import ./tests/helpers/setup.js --test --test-concurrency=1 --test-timeout=120000 \"tests/browser/**/*.test.js\"",
    "test:all": "npm test && npm run test:integration && npm run test:browser",
    "token": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "playwright": "1.64.1",
    "swagger-ui-express": "^5.0.1",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "fflate": "^0.8.3"
  }
}
