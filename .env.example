# =============================================================================================
# Cloud Screenshot Service - configuration
#
# Copy to ".env" for local development (it is git-ignored). On Render, set these in the service's
# Environment tab instead; NEVER commit real values.
# =============================================================================================

# --- Required --------------------------------------------------------------------------------

# Bearer token used by the dashboard AND the built-in test console. Generate one:
#   npm run token
# (any secure random string of 24+ characters in production). On Render use "Generate" for this variable.
API_TOKEN=GENERATE_A_SECURE_RANDOM_TOKEN

# Exact origin of the GitHub Pages dashboard. A project path is allowed and ignored:
# https://YOUR-USERNAME.github.io/your-repo  ->  https://YOUR-USERNAME.github.io
# Several origins may be listed, comma separated. Wildcards are refused.
DASHBOARD_ORIGIN=https://YOUR-USERNAME.github.io

# --- Server ----------------------------------------------------------------------------------

# Render injects PORT itself; this default is only used locally.
PORT=3000
NODE_ENV=production

# --- Browser and screenshots -----------------------------------------------------------------

SCREENSHOT_DIR=/tmp/screenshot-automation/screenshots
BROWSER_HEADLESS=true
DEFAULT_LOGIN_URL=https://aaj23525.apps.dynatrace.com/
DEFAULT_VIEWPORT_WIDTH=1920
DEFAULT_VIEWPORT_HEIGHT=1080
NAVIGATION_TIMEOUT=30000
ELEMENT_TIMEOUT=15000
ADDITIONAL_PAGE_DELAY=5000

# --- Optional tuning (defaults shown; safe to omit) --------------------------------------------

# Root of all temporary files (screenshots/, workflows/, runtime/). Default: /tmp/screenshot-automation
# DATA_DIR=/tmp/screenshot-automation
# png | jpeg ; viewport | fullPage ; jpeg quality 1-100
# SCREENSHOT_FORMAT=png
# SCREENSHOT_TYPE=viewport
# SCREENSHOT_QUALITY=80
# Screenshot storage budget; the oldest are evicted (already-downloaded ones first)
# MAX_SCREENSHOTS=200
# MAX_SCREENSHOT_MB=200
# Refuse to start Chromium when less memory than this is free (Render Free has 512 MB in total)
# MIN_FREE_MEMORY_MB=150
# Extra Chromium flags that reduce memory use. Default: true on Render, false elsewhere
# BROWSER_LOW_MEMORY=true
# Concurrent event streams, and requests per minute per address
# SSE_MAX_CLIENTS=10
# RATE_LIMIT_PER_MINUTE=600
# LOG_LEVEL=info            # debug | info | warn | error | silent
# Local development only: allow the browser to open localhost / private-network addresses (SSRF protection off!)
# ALLOW_PRIVATE_URLS=false
